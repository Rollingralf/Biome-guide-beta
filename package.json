{
  "name": "minecraft-biome-guide",
  "version": "1.1.12",
  "description": "Minecraft Biome Guide",
  "main": "main.js",
  "author": "Rollingralf",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.minecraftbiomeguide.app",
    "productName": "Minecraft Biome Guide",
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.1.2"
  }
}